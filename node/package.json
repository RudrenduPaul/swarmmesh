{
  "name": "swarmmesh-cli",
  "version": "0.2.0",
  "description": "Shared-context and memory coordination server for swarms of parallel AI agents. HTTP + WebSocket mesh server, CLI, and MCP server implementing the SwarmMesh protocol, interoperable with the Python implementation.",
  "keywords": [
    "swarmmesh",
    "ai-agents",
    "multi-agent",
    "agent-swarm",
    "agent-coordination",
    "shared-memory",
    "shared-context",
    "mcp",
    "model-context-protocol",
    "cli",
    "websocket",
    "bm25",
    "fastapi-interop",
    "typescript"
  ],
  "homepage": "https://github.com/RudrenduPaul/swarmmesh#readme",
  "bugs": {
    "url": "https://github.com/RudrenduPaul/swarmmesh/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudrenduPaul/swarmmesh.git",
    "directory": "node"
  },
  "license": "MIT",
  "author": "Rudrendu Paul",
  "contributors": [
    {
      "name": "Sourav Nandy"
    }
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "swarmmesh": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "dev": "ts-node --esm src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "~12.9.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "undici": "^7.29.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
